#include "winver.h"
#define RT_MANIFEST  24
#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1
#define IDI_ICON_ITCH 101
#define IDI_ICON_KITCH 102

// Version numbers are passed by the build (release/build.js, Makefile) via
// windres -D flags. Defaults are used for local builds without a tag.
#ifndef VER_MAJOR
#define VER_MAJOR 0
#endif
#ifndef VER_MINOR
#define VER_MINOR 0
#endif
#ifndef VER_PATCH
#define VER_PATCH 0
#endif
#ifndef VER_STRING
#define VER_STRING head
#endif
// VER_STRING is passed unquoted (-DVER_STRING=1.9.0) and stringized here
#define RC_STR2(x) #x
#define RC_STR(x) RC_STR2(x)

1 VERSIONINFO
FILEVERSION     VER_MAJOR,VER_MINOR,VER_PATCH,0
PRODUCTVERSION  VER_MAJOR,VER_MINOR,VER_PATCH,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "itch corp."
      VALUE "FileDescription", "Installer and self-update helper for the itch app"
      VALUE "FileVersion", RC_STR(VER_STRING)
      VALUE "InternalName", "itch-setup"
      VALUE "LegalCopyright", "itch corp."
      VALUE "OriginalFilename", "itch-setup.exe"
      VALUE "ProductName", "itch-setup"
      VALUE "ProductVersion", RC_STR(VER_STRING)
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

IDI_ICON_ITCH       ICON      "data\\itch.ico"
IDI_ICON_KITCH      ICON      "data\\kitch.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST MOVEABLE PURE "itch-setup.manifest.xml"
